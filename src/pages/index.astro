---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/catalog/Catalog';
import { getCatalog } from '../lib/server/products';
import { getCategories } from '../lib/server/categories';
import type { Category } from '../lib/catalog';
let catalog = { products: [], currency: 'USD' } as Awaited<ReturnType<typeof getCatalog>>;
let categories: Category[] = [];
let error = '';
try { [catalog, categories] = await Promise.all([getCatalog(Astro), getCategories(Astro)]); } catch (failure) { error = failure instanceof Error ? failure.message : 'No se pudo cargar el catálogo.'; Astro.response.status = 503; }
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout>
  {error ? <main id="contenido" class="setup-state"><img src="/villanueva-logo.png" alt="" width="52" height="52"/><h1>Villanueva</h1><p>{error}</p><a href="/" class="secondary">Volver a intentar</a></main> : <Catalog client:load initialProducts={catalog.products} initialCurrency={catalog.currency} categories={categories}/>}
</Layout>
