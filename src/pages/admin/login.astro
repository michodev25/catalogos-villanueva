---
import Layout from '../../layouts/Layout.astro';
import { isAdmin } from '../../lib/server/auth';
if (await isAdmin(Astro)) return Astro.redirect('/admin');
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Layout title="Acceso privado — Villanueva" privatePage>
  <main id="contenido" class="login-page"><a class="brand" href="/"><img src="/villanueva-logo-v2.png" alt="" width="42" height="42"/><span>Villanueva</span></a><section class="login-card"><h1>Tu catálogo,<br/>en tus manos.</h1><p>Entra para administrar tus productos.</p><form id="login-form"><label>Usuario<input name="username" autocomplete="username" value="admin" required/></label><label>Contraseña<input name="password" type="password" autocomplete="current-password" required maxlength="256"/></label><p class="feedback" id="login-error" role="alert" hidden></p><button class="primary" type="submit">Entrar al panel</button></form><a class="text-link" href="/">Volver al catálogo</a></section><span class="login-footnote">Acceso privado de Villanueva</span></main>
  <script>
    const form = document.querySelector<HTMLFormElement>('#login-form')!;
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const button = form.querySelector('button')!;
      const error = document.querySelector<HTMLElement>('#login-error')!;
      button.disabled = true; button.textContent = 'Entrando…'; error.hidden = true;
      try { const response = await fetch('/api/admin/login', { method: 'POST', body: new FormData(form) }); const data = await response.json(); if (!response.ok) throw new Error(data.error); location.assign('/admin'); }
      catch (failure) { error.textContent = failure instanceof Error ? failure.message : 'Comprueba tu conexión e inténtalo de nuevo.'; error.hidden = false; }
      finally { button.disabled = false; button.textContent = 'Entrar al panel'; }
    });
  </script>
</Layout>
